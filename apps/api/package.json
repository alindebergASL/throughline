{
  "name": "@throughline/api",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal NestJS/Fastify API for Wave A1 with a health endpoint.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-fastify": "^11.1.5",
    "@throughline/account-operations": "workspace:*",
    "@throughline/authorization": "workspace:*",
    "@throughline/content": "workspace:*",
    "@throughline/core-types": "workspace:*",
    "@throughline/db": "workspace:*",
    "@throughline/domain-profiles": "workspace:*",
    "@throughline/observability": "workspace:*",
    "@throughline/tenancy": "workspace:*",
    "@throughline/truth-ledger": "workspace:*",
    "@throughline/work-graph": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0"
